# Application
LOG_LEVEL=info
PORT=8080
TIMEOUT=15s
TRANSFER_TIMEOUT=30m
RATE_LIMIT=100
RATE_WINDOW=1m
MAX_FILE_SIZE=52428800
MAX_REQUEST_BODY_BYTES=1048576
USER_STORAGE_LIMIT_BYTES=524288000
# Total filesystem budget; uploads are locked (fs_lock) past the threshold.
SYSTEM_STORAGE_LIMIT_BYTES=10737418240
SYSTEM_STORAGE_LOCK_THRESHOLD=0.8
SHUTDOWN_TIMEOUT=5s
ACCESS_TOKEN_LIFETIME=10m
REFRESH_TOKEN_LIFETIME=24h
PUBLIC_HOST=
# Scheme for generated public URLs (share links, OAuth callback).
# TLS terminates at the ingress (GKE load balancer); be itself always serves plain http.
PUBLIC_SCHEME=http

# Db
CONN_STR=postgres://user:password@localhost:5432/webfp_drive?sslmode=disable
DB_READ_REPLICA_CONN_STR=
DB_SCHEMA=webfp
DB_MAX_CONNS=20
DB_MIN_CONNS=5
DB_MAX_CONN_IDLE_TIME=15m
DB_MAX_CONN_LIFETIME=1h

# Cache
REDIS_URL=redis://default:password@localhost:6379/0
REDIS_POOL_SIZE=5
REDIS_MIN_IDLE_CONNS=1
REDIS_POOL_TIMEOUT=4s
REDIS_CONN_MAX_IDLE_TIME=5m

# Os
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=your-r2-bucket-name
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key

# Auth
GITHUB_CLIENT_ID=client-id
GITHUB_CLIENT_SECRET=client-secret
GOOGLE_CLIENT_ID=client-id
GOOGLE_CLIENT_SECRET=client-secret
OAUTH_RETURN_URL=http://localhost:5173/auth/callback

# Email (SMTP / Gmail)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=WebFP Drive
