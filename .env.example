# Application
LOG_LEVEL=info
PORT=8080
TIMEOUT=15s
RATE_LIMIT=100
RATE_WINDOW=1m
MAX_FILE_SIZE=52428800
MAX_REQUEST_BODY_BYTES=1048576
SHUTDOWN_TIMEOUT=5s
SESSION_LIFETIME=720h
UPLOAD_URL_LIFETIME=10m
DOWNLOAD_URL_LIFETIME=2m

# Db
CONN_STR=postgres://user:password@localhost:5432/webfp_drive?sslmode=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=5
DB_MAX_CONN_IDLE_TIME=15m
DB_MAX_CONN_LIFETIME=1h

# Cache
REDIS_URL=redis://default:password@localhost:6379/0
REDIS_POOL_SIZE=10
REDIS_MIN_IDLE_CONNS=3
REDIS_POOL_TIMEOUT=4s
REDIS_CONN_MAX_IDLE_TIME=5m

# Os
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_BUCKET_NAME=your-r2-bucket-name
R2_ACCESS_KEY_ID=your-access-key-id
R2_SECRET_ACCESS_KEY=your-secret-access-key

# TLS
CERT_FILE=
KEY_FILE_TLS=
